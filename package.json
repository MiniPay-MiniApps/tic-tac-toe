{
  "name": "tic-tac-toe",
  "description": "TicTacToe - Example mini app game for MiniPay developers",
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @tic-tac-toe/app dev",
    "build": "pnpm --filter @tic-tac-toe/contract compile && pnpm --filter @tic-tac-toe/app build",
    "test": "pnpm --filter @tic-tac-toe/contract test && pnpm --filter @tic-tac-toe/app test",
    "lint": "eslint . --report-unused-disable-directives --max-warnings 0",
    "format": "prettier --write .",
    "prepare": "husky",
    "ci": "pnpm test && pnpm lint && pnpm format && pnpm build"
  },
  "lint-staged": {
    "*": "prettier --write --ignore-unknown",
    "*.{ts,tsx}": "eslint --fix"
  },
  "devDependencies": {
    "@eslint/js": "9.39.2",
    "@trivago/prettier-plugin-sort-imports": "6.0.2",
    "eslint": "9.39.2",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.0.1",
    "eslint-plugin-react-refresh": "0.4.26",
    "globals": "17.0.0",
    "husky": "9.1.7",
    "jiti": "2.6.1",
    "lint-staged": "16.2.7",
    "prettier": "3.8.0",
    "prettier-plugin-tailwindcss": "0.7.2",
    "typescript": "5.8.3",
    "typescript-eslint": "8.53.0"
  },
  "packageManager": "pnpm@10.12.1"
}
