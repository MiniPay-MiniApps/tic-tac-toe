    "@nomicfoundation/hardhat-ethers": "4.0.3",
    "@nomicfoundation/hardhat-ethers-chai-matchers": "3.0.1",
    "@nomicfoundation/hardhat-ignition": "3.0.1",
    "@nomicfoundation/hardhat-ignition-ethers": "3.0.1",
    "@nomicfoundation/hardhat-ignition-viem": "3.0.1",
    "@nomicfoundation/hardhat-viem": "3.0.1",
    "@nomicfoundation/hardhat-viem-assertions": "3.0.1",
    "@nomicfoundation/hardhat-node-test-runner": "3.0.8",
    "@nomicfoundation/hardhat-network-helpers": "3.0.1",
    "@nomicfoundation/hardhat-keystore": "3.0.1",
    "@nomicfoundation/hardhat-mocha": "3.0.1",
