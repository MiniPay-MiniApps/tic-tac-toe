    "verify": "hardhat verify",
    "lint": "eslint . --fix",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@types/node": "24.0.10",
    "dotenv": "16.4.7",
    "forge-std": "github:foundry-rs/forge-std#v1.9.4",
