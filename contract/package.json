{
  "name": "@tic-tac-toe/contract",
  "description": "TicTacToe - Smart contracts",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test",
